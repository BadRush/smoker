# Gateway Bind & Exposure Mode (direct | nginx | tunnel)
EXTERNAL_ACCESS_MODE=direct
GATEWAY_BIND_ADDR=0.0.0.0
APP_PORT=8080
DOMAIN=localhost

# Cloudflare Zero Trust Tunnel (Required when starting with: docker compose --profile tunnel up -d)
# In Zero Trust Dashboard -> Public Hostname -> Service URL: http://gateway:80
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL + TimescaleDB
POSTGRES_DB=smoker
POSTGRES_USER=smoker
POSTGRES_PASSWORD=smoker_dev_password_change_me

# Admin Credentials (Seeded on initial startup; password can be changed later in GUI)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=smoker_admin_change_me

# Security Secrets (Use >= 32 random chars in production)
JWT_SECRET=smoker_dev_jwt_secret_please_change_in_production_32chars
APP_ENCRYPTION_KEY=smoker_dev_aes_gcm_encryption_key_32bytes!

# Built-in Local Probe Auto-Enrollment
LOCAL_PROBE_AUTO_ENROLL=true
LOCAL_PROBE_NAME=Local Central Probe
LOCAL_PROBE_LOCATION=Central Host
LOCAL_PROBE_TOKEN=smk_local_dev_probe_token_change_in_production

# Auto-seed initial Public DNS, Public Apps & Public IPv6 monitors when database is empty
SEED_PUBLIC_MONITORS=true

# Allow read-only unauthenticated access to /tv wallboard API & WS on LAN
NOC_TV_ALLOW_UNAUTH=true

# Optional read-only Kiosk Token for /tv (leave empty for passwordless internal LAN NOC TV;
# when set, open /tv?key=<token> once per TV display to store a 365-day HttpOnly cookie)
NOC_TV_KIOSK_TOKEN=

# Cookie security (auto uses X-Forwarded-Proto, or force true/false)
COOKIE_SECURE=auto

# Optional Base URL for Telegram "Open Live Graph" deep links (e.g. https://smoker.example.com or http://10.10.0.5:8080)
# Leave empty if accessing only via varying local IPs and you don't want clickable links in Telegram alerts
PUBLIC_BASE_URL=
