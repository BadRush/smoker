# Gateway & Public Domain
APP_PORT=8080
DOMAIN=localhost

# PostgreSQL + TimescaleDB
POSTGRES_DB=smoker
POSTGRES_USER=smoker
POSTGRES_PASSWORD=smoker_dev_password_change_me

# Admin Credentials (Seeded on initial startup; password can be changed later in GUI)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=smoker_admin_change_me

# Security Secrets (Use >= 32 random chars in production)
JWT_SECRET=smoker_dev_jwt_secret_please_change_in_production_32chars
APP_ENCRYPTION_KEY=smoker_dev_aes_gcm_encryption_key_32bytes!

# Built-in Local Probe Auto-Enrollment
LOCAL_PROBE_AUTO_ENROLL=true
LOCAL_PROBE_NAME=Local Central Probe
LOCAL_PROBE_LOCATION=Central Host
LOCAL_PROBE_TOKEN=smk_local_dev_probe_token_change_in_production

# Auto-seed initial Public DNS & Public Apps monitors when database is empty
SEED_PUBLIC_MONITORS=true

# Allow read-only unauthenticated access to /tv wallboard API & WS on LAN
NOC_TV_ALLOW_UNAUTH=true

# Cookie security (auto uses X-Forwarded-Proto, or force true/false)
COOKIE_SECURE=auto
