# External Nginx Reverse Proxy template for Smoker Central + Probes
# Rendered by scripts/setup.sh or customized manually into /etc/nginx/sites-available/smoker.conf
# After obtaining a Let's Encrypt certificate:
#   sudo certbot --nginx -d __DOMAIN__

map $http_upgrade $smoker_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 16m;

    # Dedicated WebSocket routes (/ws/probe & /ws/live): long idle timeout + no buffering
    location /ws/ {
        proxy_pass http://__UPSTREAM_ADDR__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $smoker_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 15s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://__UPSTREAM_ADDR__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $smoker_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 15s;
        proxy_read_timeout 120s;
    }
}
